<?xml version="1.0" encoding="utf-8"?>
<!-- Botão redondo do widget (⏪ ⏯ ⏩). Tem tamanho próprio (56dp) pra o ImageView manter o círculo em qualquer
     altura (adjustViewBounds); a onda do toque fica dentro do círculo (ele é a máscara). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/wm_w_roxo_toque">
    <item>
        <shape android:shape="oval">
            <size android:width="56dp" android:height="56dp" />
            <solid android:color="@color/wm_w_botao" />
            <stroke android:width="1dp" android:color="@color/wm_w_borda" />
        </shape>
    </item>
</ripple>
