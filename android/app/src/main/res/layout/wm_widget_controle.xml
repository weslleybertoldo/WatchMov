<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Controle da TV" (pedido dele 07/11/2026): o Controle remoto do app na tela inicial, no mesmo desenho
     aprovado (tema escuro). Só views que o RemoteViews aceita (LinearLayout, FrameLayout, TextView, ImageView,
     ImageButton): qualquer outra (View, Space…) vira "Não foi possível carregar o widget" no aparelho. Espaçadores são
     FrameLayout vazios. Tudo em pesos: encolhe e cresce junto com o widget. Quem liga os cliques é o ControleWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wm_w_fundo"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. Cabeçalho: a TV que está sendo controlada (tocar = trocar) + "Trocar TV" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wm_w_tv_nome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/wm_w_toque_texto"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="@string/wm_widget_nome"
            android:textColor="@color/wm_w_texto"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wm_w_trocar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/wm_w_toque_texto"
            android:contentDescription="@string/wm_widget_trocar_tv"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/wm_widget_trocar_tv"
            android:textColor="@color/wm_w_roxo"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2 a 5: os controles (somem sem token ou sem TV escolhida). A cruz fica com a maior parte da altura. -->
    <LinearLayout
        android:id="@+id/wm_w_controles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 2. Cruz direcional: ↑ / ← OK → / ↓ num bloco arredondado (os cantos do 3×3 ficam vazios) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="50"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:background="@drawable/wm_w_cartao"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/wm_w_cima"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/wm_w_toque_seta"
                        android:contentDescription="@string/wm_widget_cima"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/wm_w_seta_cima" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/wm_w_esq"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/wm_w_toque_seta"
                        android:contentDescription="@string/wm_widget_esquerda"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/wm_w_seta_esq" />

                    <!-- OK: o círculo roxo (fitCenter = sempre redondo) acende junto com o toque na célula inteira -->
                    <FrameLayout
                        android:id="@+id/wm_w_ok"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/wm_widget_ok"
                        android:padding="2dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/wm_w_ok_fundo" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:text="@string/wm_widget_ok"
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/wm_w_dir"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/wm_w_toque_seta"
                        android:contentDescription="@string/wm_widget_direita"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/wm_w_seta_dir" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/wm_w_baixo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/wm_w_toque_seta"
                        android:contentDescription="@string/wm_widget_baixo"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/wm_w_seta_baixo" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 3. Voltar · Início (largos, arredondados) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="12"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wm_w_voltar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/wm_w_botao"
                android:contentDescription="@string/wm_widget_voltar"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wm_w_voltar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/wm_widget_voltar"
                    android:textColor="@color/wm_w_texto"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wm_w_inicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/wm_w_botao"
                android:contentDescription="@string/wm_widget_inicio"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wm_w_inicio" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/wm_widget_inicio"
                    android:textColor="@color/wm_w_texto"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. ⏪ 10 s · ⏯ · ⏩ 10 s, redondos: a altura da linha vira o diâmetro (adjustViewBounds deixa o
             círculo quadrado); o ⏯ é maior, como no app -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="15"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/wm_w_rew"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/wm_widget_voltar_10s">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wm_w_redondo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/wm_w_rew" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/wm_widget_10s"
                        android:textColor="@color/wm_w_apagado"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/wm_w_playpause"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/wm_widget_play_pausa">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wm_w_redondo" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/wm_w_playpause" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/wm_w_ff"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/wm_widget_avancar_10s">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wm_w_redondo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/wm_w_ff" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/wm_widget_10s"
                        android:textColor="@color/wm_w_apagado"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 5. ⏮ Ep. anterior · ✓ Assistido · ⏭ Próximo ep. (ícone em cima, texto embaixo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="15"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wm_w_ep_ant"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/wm_w_botao"
                android:contentDescription="@string/wm_widget_ep_anterior"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wm_w_ep_ant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/wm_widget_ep_anterior"
                    android:textColor="@color/wm_w_texto"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wm_w_assistido"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/wm_w_botao"
                android:contentDescription="@string/wm_widget_assistido"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wm_w_assistido" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/wm_widget_assistido"
                    android:textColor="@color/wm_w_texto"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wm_w_ep_prox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/wm_w_botao"
                android:contentDescription="@string/wm_widget_proximo_ep"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wm_w_ep_prox" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/wm_widget_proximo_ep"
                    android:textColor="@color/wm_w_texto"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Sem token ou sem TV escolhida: o aviso fica no lugar dos controles; tocar abre o app -->
    <LinearLayout
        android:id="@+id/wm_w_aviso"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/wm_w_botao"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/wm_w_tv" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/wm_widget_aviso"
            android:textColor="@color/wm_w_texto"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
