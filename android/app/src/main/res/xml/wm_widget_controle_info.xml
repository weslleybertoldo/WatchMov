<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Controle da TV": 4×4 por padrão (minWidth/minHeight = 4 células na conta antiga, targetCell no Android 12+),
     redimensionável nos dois sentidos — o layout encolhe e cresce pelos pesos. Sem atualização periódica: o widget só
     muda quando o app ou a janelinha Trocar TV gravam algo (ControleWidget.atualizarTodos). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="180dp"
    android:minResizeHeight="220dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/wm_widget_controle"
    android:previewLayout="@layout/wm_widget_controle"
    android:description="@string/wm_widget_descricao" />
